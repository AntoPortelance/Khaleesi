[Unit]
Description=Khaleesi test-stand interface
After=network.target

[Service]
User=khaleesi
Group=khaleesi
WorkingDirectory=/opt/khaleesi
Environment=KHALEESI_HOST=0.0.0.0
Environment=KHALEESI_PORT=443
Environment=KHALEESI_DATA_DIR=/var/lib/khaleesi
Environment=KHALEESI_SSL_CERTFILE=/etc/khaleesi/tls/server.crt
Environment=KHALEESI_SSL_KEYFILE=/etc/khaleesi/tls/server.key
ExecStart=/opt/khaleesi/.venv/bin/python -m khaleesi
Restart=always
RestartSec=2

# Allows port 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/khaleesi
PrivateTmp=true

[Install]
WantedBy=multi-user.target
